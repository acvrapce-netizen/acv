# Supabase/Postgres connection stringovi za Prisma.
# Vidi CLAUDE.md — produkcijski connection string (nova firma) ide tek pred pravi launch.
#
# DATABASE_URL = pooler (Supabase "Connection pooling", port 6543, transaction mode) —
#   koristi app na runtimeu (posebno na Vercelu/serverlessu, da ne potroši sve konekcije).
# DIRECT_URL   = direktna konekcija (port 5432) — koristi Prisma CLI za migracije,
#   jer PgBouncer transaction-mode ne podržava prepared statements koje migracije trebaju.
#
# Oba stringa nađeš u Supabase dashboardu: Project Settings -> Database -> Connection string.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Google Cloud Vision API — OCR za prometnu/osobnu iskaznicu (portano iz Rent-a-Car
# Manager projekta). Zaseban GCP projekt/ključ za ovu (novu, zasebnu) firmu, ne
# dijeliti s RENT-A-CAR/NAVALIS-CISSA. Treba: GCP projekt + omogućen Vision API +
# billing + API key (Google Cloud Console -> APIs & Services -> Credentials).
GOOGLE_VISION_API_KEY=""

# Fiskalizacija (CIS/Porezna uprava) - FINA testni certifikat za cistest okolinu.
# Za razvoj: reuse isti test cert kao RENT-A-CAR app/FLEET (CLAUDE.md), radi na
# NAVALIS-CISSA OIB-u čak i za ovu (drugu) firmu, jer je cistest okolina odvojena
# od produkcije. Produkcijski FINA cert nove firme dolazi tek pred launch.
FINA_CERT_BASE64=""
FINA_CERT_PASSWORD=""
FINA_OIB=""
FINA_OZN_PP=""
FINA_OZN_NU=""
FINA_URL="https://cistest.apis-it.hr:8449/FiskalizacijaServiceTest"
